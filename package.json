{
  "name": "zengin-pl-browser-extension",
  "version": "0.1.0",
  "private": true,
  "description": "全銀コード（銀行・支店コード）を検索するChrome/Firefox向けブラウザ拡張",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:chrome": "node scripts/build.mjs chrome",
    "build:firefox": "node scripts/build.mjs firefox",
    "build": "npm run build:chrome && npm run build:firefox",
    "icons": "node scripts/sync-icon.mjs",
    "icons:offline": "node scripts/sync-icon.mjs --offline"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/webextension-polyfill": "^0.12.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  }
}
